{
  "expo": {
    "name": "ORA",
    "slug": "ORA",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1E21"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ORA folosește fotografiile pentru actualizarea avatarului tău."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
